# Database (use USE_SQLITE=1 for local dev without PostgreSQL)
USE_SQLITE=1
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# GitHub OAuth (user login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (organization install + private repo access)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=dpdp-compliance-scanner

# Redis / RQ worker (optional — falls back to inline thread pool)
REDIS_URL=redis://127.0.0.1:6379/0
DPDP_RQ_QUEUE=dpdp-scans
DPDP_INLINE_WORKERS=4

# URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://127.0.0.1:8000

# LLM
GOOGLE_API_KEY=
DPDP_SKIP_DEEP_REVIEW=0
